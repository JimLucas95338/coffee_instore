// In-Store Ordering Models
// ========================

enum DrinkSize {
  SMALL
  MEDIUM
  LARGE
}

enum MilkType {
  WHOLE
  TWO_PERCENT
  OAT
  ALMOND
  SOY
  COCONUT
  NONE
}

enum DrinkTemp {
  HOT
  ICED
}

enum InStoreOrderStatus {
  RECEIVED
  IN_PROGRESS
  READY
  PICKED_UP
  CANCELLED
}

enum InStorePaymentMethod {
  CARD
  APPLE_PAY
  CASH
}

enum InStorePaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model MenuItem {
  id          String             @id @default(cuid())
  name        String
  description String?
  category    String             // ESPRESSO, DRIP, COLD, TEA, FOOD, RETAIL
  basePrice   Float              // Price for SMALL / default size
  mediumPrice Float?             // Price for MEDIUM (null if no sizes)
  largePrice  Float?             // Price for LARGE (null if no sizes)
  imageUrl    String?
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  allowSizes  Boolean            @default(true)
  allowMilk   Boolean            @default(true)
  allowTemp   Boolean            @default(true)
  coffeeId    String?
  coffee      Coffee?            @relation(fields: [coffeeId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  addOns      MenuAddOn[]
  orderItems  InStoreOrderItem[]

  @@index([category])
  @@map("menu_items")
}

model MenuAddOn {
  id        String     @id @default(cuid())
  name      String
  price     Float
  category  String     @default("GENERAL") // SYRUP, TOPPING, EXTRA
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("menu_add_ons")
}

model InStoreOrder {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique
  displayNumber         Int
  status                InStoreOrderStatus    @default(RECEIVED)
  customerName          String?
  subtotal              Float
  tax                   Float                 @default(0)
  total                 Float
  paymentMethod         InStorePaymentMethod
  paymentStatus         InStorePaymentStatus  @default(PENDING)
  stripePaymentIntentId String?
  paidAt                DateTime?
  source                String                @default("KIOSK") // KIOSK or POS
  employeeId            String?
  employee              User?                 @relation("InStoreEmployeeOrders", fields: [employeeId], references: [id])
  loyaltyPhone          String?
  loyaltyPointsEarned   Int?
  loyaltyPointsRedeemed Int?
  loyaltyDiscount       Float?
  items                 InStoreOrderItem[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("in_store_orders")
}

model InStoreOrderItem {
  id          String      @id @default(cuid())
  quantity    Int         @default(1)
  unitPrice   Float
  totalPrice  Float
  size        DrinkSize?
  milkType    MilkType?
  temperature DrinkTemp?
  addOns      String?     // JSON: [{addOnId, name, price}]
  notes       String?
  menuItemId  String
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id])
  packageId   String?
  package     Package?    @relation(fields: [packageId], references: [id])
  orderId     String
  order       InStoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("in_store_order_items")
}

// Single-row settings table for app-wide configuration like the active theme.
// Use id="singleton" so there's only ever one row.
model AppSetting {
  id        String   @id @default("singleton")
  themeId   String   @default("3rd-space")
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
