// ============================================
// AFFILIATE SYSTEM MODELS
// ============================================

// Affiliate status for managing affiliate lifecycle
enum AffiliateStatus {
  PENDING      // Created but not onboarded to Stripe
  ACTIVE       // Fully active and can earn commissions
  PAUSED       // Temporarily disabled
  TERMINATED   // Permanently disabled
}

// Conversion status for tracking commission lifecycle
enum ConversionStatus {
  PENDING    // Order placed, waiting for fulfillment
  APPROVED   // Order shipped, commission approved
  PAID       // Commission paid out
  CANCELLED  // Order cancelled/refunded
}

// Payout status for tracking payment processing
enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Main affiliate account model
model Affiliate {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  password        String          // bcrypt hashed password
  referralCode    String          @unique // e.g., "JAKE20" - used in ?ref=JAKE20 links
  commissionRate  Decimal         @default(0.20) @db.Decimal(5, 4) // 20% default
  status          AffiliateStatus @default(PENDING)
  
  // Stripe Connect fields for automated payouts
  stripeAccountId String?         // acct_xxx from Stripe Connect
  stripeOnboarded Boolean         @default(false) // true when fully onboarded
  
  // Denormalized stats for performance (updated on each conversion)
  totalClicks     Int             @default(0)
  totalOrders     Int             @default(0)
  totalRevenue    Decimal         @default(0) @db.Decimal(10, 2)
  totalCommission Decimal         @default(0) @db.Decimal(10, 2)
  pendingBalance  Decimal         @default(0) @db.Decimal(10, 2) // approved but not paid
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  discountCodes   AffiliateCode[]
  conversions     AffiliateConversion[]
  payouts         AffiliatePayout[]
  clicks          AffiliateClick[]

  @@map("affiliates")
}

// Affiliate-specific discount codes with custom commission rates
model AffiliateCode {
  id              String   @id @default(cuid())
  code            String   @unique // e.g., "JAKE5" or "JAKE10"
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  
  discountPercent Decimal  @db.Decimal(5, 4) // 0.05 = 5%, 0.10 = 10%
  commissionRate  Decimal  @db.Decimal(5, 4) // 0.15 = 15%, 0.10 = 10%
  
  usageCount      Int      @default(0)
  maxUsage        Int?     // null = unlimited
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  
  // Relations
  conversions     AffiliateConversion[]

  @@index([affiliateId])
  @@map("affiliate_codes")
}

// Track affiliate link clicks for analytics
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  
  visitorId   String    // anonymous tracking ID from cookie for attribution
  ipAddress   String?   // for fraud detection
  userAgent   String?   // browser info
  referer     String?   // where they came from
  landingPage String    // which page they landed on
  
  createdAt   DateTime  @default(now())
  
  @@index([affiliateId, createdAt])
  @@index([visitorId])
  @@map("affiliate_clicks")
}

// Track conversions (orders attributed to affiliates)
model AffiliateConversion {
  id               String           @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate        @relation(fields: [affiliateId], references: [id])
  
  // Can be linked to either Order or StoreOrder
  orderId          String?          @unique
  order            Order?           @relation(fields: [orderId], references: [id])
  storeOrderId     String?          @unique
  storeOrder       StoreOrder?      @relation(fields: [storeOrderId], references: [id])
  
  // Affiliate code used (if any)
  affiliateCodeId  String?
  affiliateCode    AffiliateCode?   @relation(fields: [affiliateCodeId], references: [id])
  
  // Financial details at time of conversion
  orderSubtotal    Decimal          @db.Decimal(10, 2) // before discount
  discountAmount   Decimal          @default(0) @db.Decimal(10, 2)
  commissionRate   Decimal          @db.Decimal(5, 4) // rate at time of conversion
  commissionAmount Decimal          @db.Decimal(10, 2) // calculated commission
  
  status           ConversionStatus @default(PENDING)
  
  // Attribution data
  clickId          String?          // which click led to this conversion
  attributedAt     DateTime         @default(now())
  
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  payoutId         String?
  payout           AffiliatePayout? @relation(fields: [payoutId], references: [id])
  
  @@index([affiliateId, status])
  @@index([affiliateId, createdAt])
  @@map("affiliate_conversions")
}

// Track payouts to affiliates
model AffiliatePayout {
  id               String        @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate     @relation(fields: [affiliateId], references: [id])
  
  amount           Decimal       @db.Decimal(10, 2)
  stripeTransferId String?       // tr_xxx from Stripe
  status           PayoutStatus  @default(PENDING)
  
  conversions      AffiliateConversion[]
  
  createdAt        DateTime      @default(now())
  processedAt      DateTime?
  failedReason     String?
  
  @@index([affiliateId, status])
  @@index([status, createdAt])
  @@map("affiliate_payouts")
}

model AffiliatePromotion {
  id              String    @id @default(cuid())
  name            String
  discountPercent Float
  isActive        Boolean   @default(true)
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("affiliate_promotions")
}

// ========================
// Loyalty Program
// ========================

model LoyaltyMember {
  id           String               @id @default(cuid())
  phone        String               @unique
  name         String?
  points       Int                  @default(0)
  totalSpent   Float                @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LoyaltyTransaction[]

  @@map("loyalty_members")
}

model LoyaltyTransaction {
  id          String        @id @default(cuid())
  memberId    String
  member      LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orderId     String?
  points      Int           // positive = earned, negative = redeemed
  type        String        // EARN or REDEEM
  description String?
  createdAt   DateTime      @default(now())

  @@index([memberId])
  @@map("loyalty_transactions")
}

